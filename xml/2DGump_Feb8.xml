<MCFile treename="SelectedEvents" filename="/flare/neutrinoGPU/SBN_PROfit/sBruce/Feb9/SBND_SpringMC_rewgt_sBruce.txt" scale = "1.0" pot="5.33e20">
    <friend treename="multisigmaTree" />
    <friend treename="multisimTree" />
    <branch
        associated_subchannel = "nu_SBND_numu_cc"
        model_rule            = "1"
        additional_weight     = "(!is_nc)*(true_pdg == 14 || true_pdg == -14)"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
        <variable>baseline/(nu_E_true*1000.0)</variable>
        <variable>nu_E_calo</variable>
	<variable>del_p</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu_nc"
        model_rule            = "1"
        additional_weight     = "is_nc"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>baseline/(nu_E_true*1000.0)</variable>
	<variable>nu_E_calo</variable>
	<variable>del_p</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu_bkg"
        model_rule            = "0"
        additional_weight     = "(true_pdg != -14 && true_pdg != 14)"
        >
        <variable2D>nu_E_calo;del_p</variable2D>
	<variable>nu_E_calo</variable>
	<variable>nu_E_calo</variable>
	<variable>del_p</variable>
    </branch>
</MCFile>

