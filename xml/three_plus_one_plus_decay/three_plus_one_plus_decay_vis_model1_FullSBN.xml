<?xml version="1.0" ?>

<!-- One Mode -->
<mode name="nu" />

<!-- Two Detector SBN Snalysis-->
<detector name="SBND" pot="9.7e20"/>
<detector name="ICARUS" pot="13.1e20"/>

<!-- Two Channels, numu and nue selections -->
<channel name="numu" plotname="#nu_{#mu} Selection">
    <bins unit = "Reconstructed Neutrino Energy [GeV]" min="0.2" max="3" nbins="28" />
    <bins unit = "True Neutrino Energy [GeV]" min="0" max="3" nbins="20"/>
    <bins unit = "True Baseline [km]" min="0" max="0.7" nbins="20" />
    <subchannel name="numucc_osc"   plotname="#nu_{#mu} #rightarrow #nu_{#mu} CC (osc + decay disapp.)"   color="#df19f1"/>
    <subchannel name="numucc_decay" plotname="#nu_{#mu} #rightarrow #nu_{#mu} CC (decay app.)"            color="#ff3336"/>
</channel>
<channel name="nue" plotname="#nu_{e} Selection">
    <bins unit = "Reconstructed Neutrino Energy [GeV]" min="0.2" max="3" nbins="14"  />
    <bins unit = "True Neutrino Energy [GeV]" min="0" max="3" nbins="20"/>
    <bins unit = "True Baseline [km]" min="0" max="0.7" nbins="20" />
    <subchannel name="intrinsic_osc"   plotname="#nu_{e} #rightarrow #nu_{e} (osc + decay disapp.)"       color="#e4a64a"/>
    <subchannel name="intrinsic_decay" plotname="#nu_{e} #rightarrow #nu_{e} (decay app.)"                color="#143cf1"/>
    <subchannel name="fullosc_osc"     plotname="#nu_{#mu} #rightarrow #nu_{e} (osc app.)"                color="#19f30e"/>
    <subchannel name="fullosc_decay"   plotname="#nu_{#mu} #rightarrow #nu_{e} (decay app.)"              color="#08b4df"/>
</channel>

<!-- The Physics model -->
<!-- Rules 1/2/3 are the same-bin (parent) oscillation contributions for the three
     flavor channels. Rules 4/5/6 are the visible-decay daughter contributions that
     migrate to lower truth-E bins; the duplicated MCFile entries below give every
     event a rule-1/2/3 copy and a rule-4/5/6 copy so the two pieces can be plotted
     as separately-coloured subchannels. -->
<model tag="3+1_decay_vis_model1">
    <rule index="0" name="No Osc"/>
    <rule index="1" name="P_mumu_osc"/>
    <rule index="2" name="P_mue_osc"/>
    <rule index="3" name="P_ee_osc"/>
    <rule index="4" name="P_mumu_decay"/>
    <rule index="5" name="P_mue_decay"/>
    <rule index="6" name="P_ee_decay"/>
    <parameter variable_index = "1" name="E"/>
    <parameter variable_index = "2" name="L"/>
</model>

<!-- Where to find the Montecarlo and how to fill all the subchannels defined above-->
<MCFile treename="events/selectedNu" filename="/nevis/riverside/data/leehagaman/PROfit_files/Tutorial2025/sbnd_bnbcv_files_localtest.txt" scale = "1.0" pot="2.15692e19">
    <friend treename="events/multisigmaTree" />
    <friend treename="events/multisimTree" />
    <branch
        associated_subchannel = "nu_SBND_numu_numucc_osc"
        model_rule            = "1"
        additional_weight     = "0.9*CC*(truePDG == 14 || truePDG == -14)*(recoE>0)"
        >
        <variable>recoE</variable>
        <variable>trueE</variable>
        <variable>trueL/1000.0</variable>
    </branch>
    <branch
        associated_subchannel = "nu_SBND_numu_numucc_decay"
        model_rule            = "4"
        additional_weight     = "0.9*CC*(truePDG == 14 || truePDG == -14)*(recoE>0)"
        >
        <variable>recoE</variable>
        <variable>trueE</variable>
        <variable>trueL/1000.0</variable>
    </branch>
</MCFile>

<MCFile treename="events/selectedNu" filename="/nevis/riverside/data/leehagaman/PROfit_files/Tutorial2025/icarus_bnbcv_files_localtest.txt" scale = "1.0" pot="1.60787e20">
