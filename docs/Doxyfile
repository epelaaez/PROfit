# Doxyfile for PROfit
# Generated for use with GitHub Actions → GitHub Pages

#---------------------------------------------------------------------------
# Project metadata
#---------------------------------------------------------------------------
PROJECT_NAME           = "PROfit"
PROJECT_NUMBER         = ""
PROJECT_BRIEF          = "Open-source C++ framework for neutrino oscillation analysis and BSM physics fitting"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

#---------------------------------------------------------------------------
# Input
#---------------------------------------------------------------------------
INPUT                  = inc/ src/
FILE_PATTERNS          = *.h *.cxx
RECURSIVE              = NO
EXCLUDE                =
EXCLUDE_PATTERNS       = */working_dir/* */build/*
STRIP_FROM_PATH        = .
STRIP_FROM_INC_PATH    =

#---------------------------------------------------------------------------
# Extraction settings — document everything
#---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
INTERNAL_DOCS          = NO
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
BUILTIN_STL_SUPPORT    = YES
TYPEDEF_HIDES_STRUCT   = NO

#---------------------------------------------------------------------------
# Preprocessing (needed for Eigen / ROOT macros)
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
SKIP_FUNCTION_MACROS   = YES
PREDEFINED             = EIGEN_STRONG_INLINE= \
                         ClassDef(x,y)= \
                         ClassImp(x)=

#---------------------------------------------------------------------------
# Source browsing
#---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

#---------------------------------------------------------------------------
# HTML output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_FILE_EXTENSION    = .html
HTML_COLORSTYLE        = LIGHT
HTML_TIMESTAMP         = NO
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
TREEVIEW_WIDTH         = 250
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
SEARCHENGINE           = YES

# Use Doxygen Awesome theme if available (looks good on GitHub Pages).
# Falls back gracefully if not present.
HTML_EXTRA_STYLESHEET  = docs/doxygen-awesome.css

#---------------------------------------------------------------------------
# LaTeX / other outputs (disabled — Pages only needs HTML)
#---------------------------------------------------------------------------
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO
GENERATE_DOCBOOK       = NO

#---------------------------------------------------------------------------
# Graphs (requires Graphviz dot)
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_NUM_THREADS        = 4
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
GROUP_GRAPHS           = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
GRAPHICAL_HIERARCHY    = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_TRANSPARENT        = YES
MAX_DOT_GRAPH_DEPTH    = 3

#---------------------------------------------------------------------------
# Warnings
#---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_FORMAT            = "$file:$line: $text"
WARN_LOGFILE           =
